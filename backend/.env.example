# Copy to .env and adjust. All values shown are the built-in defaults.

# Core
F1_ENV=development
F1_LOG_LEVEL=INFO
# SQLite for development; swapping to Postgres is only this line:
#   F1_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/f1
F1_DATABASE_URL=sqlite:///./f1_dashboard.db

# Regulation regime -- a field, never a hardcoded assumption (guide rule 6)
F1_REGS_REGIME=2026
F1_SEASON=2026

# Data sources (neither needs an API key)
F1_OPENF1_URL=https://api.openf1.org/v1
F1_OPENF1_TIMEOUT=10
F1_FASTF1_CACHE=./.fastf1_cache

# Live loop cadence, seconds
F1_RACE_POLL_INTERVAL=5
F1_QUALI_POLL_INTERVAL=5
F1_RC_POLL_INTERVAL=2

# Model registry / validation gate (guide rule 2)
F1_MODEL_DIR=./model_artifacts
F1_VALIDATION_MARGIN=0.0
F1_LEAKAGE_SCORE=0.98
# Leave false so promotion stays a deliberate act after reviewing the score.
F1_AUTO_PROMOTE=false

# Frontend origin allowed to call the API
F1_CORS_ORIGINS=http://localhost:3000
