# Copy to .env and adjust. All values shown are the built-in defaults.

# Core
F1_ENV=development
F1_LOG_LEVEL=INFO
# SQLite for development; swapping to Postgres is only this line:
#   F1_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/f1
F1_DATABASE_URL=sqlite:///./f1_dashboard.db

# Regulation regime -- a field, never a hardcoded assumption (guide rule 6)
F1_REGS_REGIME=2026
F1_SEASON=2026

# Data sources
F1_OPENF1_URL=https://api.openf1.org/v1
F1_OPENF1_TIMEOUT=10
F1_FASTF1_CACHE=./.fastf1_cache

# OpenF1 account (https://openf1.org, sponsor tier). Needed to watch a session
# LIVE: while one is running, OpenF1 refuses every unauthenticated request,
# past sessions included. Leave blank to use the free API between sessions.
# Put the real values in backend/.env (gitignored), never in this file.
F1_OPENF1_USERNAME=
F1_OPENF1_PASSWORD=
# Requests per minute across the whole server; defaults to 55 with an
# account (limit 60) and 28 without (limit 30).
# F1_OPENF1_MAX_RPM=55

# F1 TV subscriber login (any tier with live timing; Premium via Apple TV works).
# Paste the WHOLE value of the formula1.com `login-session` cookie (DevTools ->
# Application -> Cookies). Unlocks F1's live car telemetry + positions and its
# archive of past sessions (scripts/backup_f1_archive.py). Lasts ~4 days.
# Personal use only. Real value goes in backend/.env, never here.
F1TV_LOGIN_SESSION=
# F1_ARCHIVE_DIR=./archive

# Live sessions: watch OpenF1 and follow whatever is on, unprompted.
F1_LIVE_AUTOSTART=true
F1_LIVE_WATCH_INTERVAL=60
F1_LIVE_POSITION_INTERVAL=4
F1_LIVE_TIMING_INTERVAL=20

# Live loop cadence, seconds (a race tick is 5 requests)
F1_RACE_POLL_INTERVAL=10
F1_QUALI_POLL_INTERVAL=10
F1_RC_POLL_INTERVAL=2

# Model registry / validation gate (guide rule 2)
F1_MODEL_DIR=./model_artifacts
F1_VALIDATION_MARGIN=0.0
F1_LEAKAGE_SCORE=0.98
# Leave false so promotion stays a deliberate act after reviewing the score.
F1_AUTO_PROMOTE=false

# Frontend origin allowed to call the API
F1_CORS_ORIGINS=http://localhost:3000
