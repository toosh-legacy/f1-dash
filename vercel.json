{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "public",
  "installCommand": "echo no dependencies",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/config.js",
      "headers": [{ "key": "cache-control", "value": "no-store" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "cache-control", "value": "no-store" }]
    }
  ]
}
